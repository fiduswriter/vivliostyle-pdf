{
    "name": "vivliostyle-pdf",
    "version": "0.1.1",
    "description": "Browser-only PDF export via vivliostyle pagination + custom DOM-to-PDF emitter",
    "type": "module",
    "license": "LGPL-3.0-or-later",
    "author": "Johannes Wilm <johannes@fiduswriter.org>",
    "homepage": "https://git.fiduswriter.org/fiduswriter/vivliostyle-pdf#readme",
    "bugs": {
        "url": "https://git.fiduswriter.org/fiduswriter/vivliostyle-pdf/issues"
    },
    "repository": {
        "type": "git",
        "url": "ssh://git@git.fiduswriter.org/fiduswriter/vivliostyle-pdf.git"
    },
    "keywords": [
        "pdf",
        "vivliostyle",
        "css-paged-media",
        "browser",
        "pdf-lib",
        "svg"
    ],
    "packageManager": "pnpm@10.29.3",
    "main": "./lib/index.js",
    "module": "./lib/index.js",
    "types": "./lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        }
    },
    "files": [
        "lib",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "dev": "vite",
        "build": "tsc -p tsconfig.build.json",
        "build:demo": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "test:e2e": "playwright test",
        "gen:assets": "node scripts/gen-assets.mjs",
        "prepublishOnly": "pnpm run build"
    },
    "dependencies": {
        "@pdfme/pdf-lib": "^6.1.12",
        "@vivliostyle/print": "^2.44.1",
        "fontkit": "^2.0.4",
        "svg4pdf-lib": "^0.1.1"
    },
    "devDependencies": {
        "@playwright/test": "^1.49.0",
        "@types/node": "^26.2.0",
        "pdfjs-dist": "^6.2.108",
        "typescript": "^5.7.0",
        "vite": "^6.0.0"
    }
}
